# Credentials live only in environment variables (this file is loaded as one; keep it gitignored).
# SCHEMA_SCOUT_ENV=local   # or production
SCHEMA_SCOUT_DATABASE__PASSWORD=
# LLM key: the provider SDKs read their usual variable (or use SCHEMA_SCOUT_LLM__API_KEY)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional non-secret overrides:
# SCHEMA_SCOUT_LLM__PROVIDER=anthropic
# SCHEMA_SCOUT_LLM__MODEL=claude-sonnet-5-5
# SCHEMA_SCOUT_DATABASE__HOST=other-host
